{
  "name": "ldrn-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Little Rainbows Day Nursery React frontend. Builds both the standalone static preview and the LDRN WordPress theme bundle.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:wp": "vite build --base=/wp-content/themes/ldrn-theme/dist/",
    "sync:theme": "node scripts/sync-wp-theme.mjs",
    "build:theme": "npm run build:wp && npm run sync:theme",
    "lint": "eslint --cache src",
    "preview": "vite preview"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^1.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12"
  },
  "license": "UNLICENSED"
}
